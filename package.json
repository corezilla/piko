{
  "name": "piko-runtime",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {"node": ">=22.19.0"},
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && python3 tests/contract/validate_v03_contract.py",
    "test:scenario": "SCENARIO_E2E=1 vitest run tests/integration/scenario-e2e.test.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "matrix-js-sdk": "38.2.0",
    "tsx": "4.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
