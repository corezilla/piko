{
  "name": "piko-runtime",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "test": "npm run test:node && vitest run",
    "test:node": "tsx --test src/*.test.ts",
    "cli": "tsx scripts/piko-cli.ts",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && python3 tests/contract/validate_v03_contract.py",
    "check:coverage": "python3 /Users/ben/work/STD/scripts/validate-coverage --project-root .",
    "check:checklist": "python3 /Users/ben/work/STD/scripts/validate-checklist --project-root .",
    "test:scenario": "vitest run --config vitest.live.config.ts tests/integration/scenario-e2e.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:xfer": "PIKO_SCP_REMOTE=${PIKO_SCP_REMOTE:-} vitest run tests/integration/transfer-scp-live.test.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "matrix-js-sdk": "38.2.0",
    "tsx": "4.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
