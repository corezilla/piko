# Host and service addresses — the ONE place they are named.
#
# Rule: this machine is localhost / 127.0.0.1. Any other host is named here,
# by NAME (an SSH alias or a DNS name), never by IP. Copy to `config/hosts.env`
# (gitignored) and adjust. `scripts/load-env.sh` loads it; `npm run check`
# fails if a script bakes an address in instead.

# ── this machine ─────────────────────────────────────────────────────
# Services that run locally. Loopback is the only address that is true
# everywhere, so these stay as 127.0.0.1.
PIKO_URL=http://127.0.0.1:8787
TIER_URL=http://127.0.0.1:8181

# ── other machines (by NAME) ─────────────────────────────────────────
# The HIFM inference target, addressed the way the SSH client addresses it.
# A7048_HOST=a7048
# The Matrix/Synapse provisioning target.
# PIKO_REMOTE_HOST=mlp@m5air

# ── hermetic scp data plane ──────────────────────────────────────────
# Filled in by `scripts/datanode-env.sh up` into var/datanode/env; leave
# these unset to run the scp e2e against whatever that emitted.
# PIKO_SCP_REMOTE=ben@localhost:
# PIKO_SCP_PORT=
# PIKO_SCP_KEY_REF=
# PIKO_SCP_KNOWN_HOSTS=
# PIKO_SCP_DIR=
