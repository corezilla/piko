{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piko.local/schemas/agent-runtime-v0.2.schema.json",
  "title": "Piko 智能体运行时契约提案",
  "description": "供跨项目评审的中文 Schema 草案，不是已冻结契约。",
  "$defs": {
    "OpaqueId": {"type":"string","minLength":1,"maxLength":256},
    "Version": {"oneOf":[{"type":"integer","minimum":1},{"type":"string","minLength":1,"maxLength":256}]},
    "Timestamp": {"type":"string","format":"date-time"},
    "Digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "Reference": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","version"],
      "properties":{"id":{"$ref":"#/$defs/OpaqueId"},"version":{"$ref":"#/$defs/Version"},"digest":{"$ref":"#/$defs/Digest"}}
    },
    "ErrorDescriptor": {
      "type":"object",
      "additionalProperties":false,
      "required":["code","category","retryable"],
      "properties":{
        "code":{"type":"string","minLength":1,"maxLength":128},
        "category":{"type":"string","minLength":1,"maxLength":64},
        "message":{"type":"string","maxLength":2048},
        "retryable":{"type":"boolean"},
        "details_ref":{"$ref":"#/$defs/OpaqueId"},
        "details":{"type":"object","additionalProperties":true}
      }
    },
    "Blocker": {
      "type":"object",
      "additionalProperties":false,
      "required":["code","category","affected_scope"],
      "properties":{
        "code":{"type":"string","minLength":1,"maxLength":128},
        "category":{"type":"string","minLength":1,"maxLength":64},
        "required_capability":{"type":"string","maxLength":256},
        "affected_scope":{"type":"string","minLength":1,"maxLength":512},
        "details_ref":{"$ref":"#/$defs/OpaqueId"}
      }
    },
    "ApiErrorEnvelope": {
      "type":"object",
      "additionalProperties":false,
      "required":["api_version","request_id","correlation_id","error","observed_at"],
      "properties":{
        "api_version":{"const":"agent-runtime/v1"},
        "request_id":{"$ref":"#/$defs/OpaqueId"},
        "correlation_id":{"$ref":"#/$defs/OpaqueId"},
        "error":{"$ref":"#/$defs/ErrorDescriptor"},
        "observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "AgentRuntimeReadiness": {
      "type":"object","additionalProperties":false,
      "required":["status","service_instance_id","service_version","api_version","pi_sdk_version","runtime_profile_ref","slot_snapshot_ref","total_slots","available_slots","dependencies","compatibility_manifest_ref","recovery_required_count","accepting_runs","degraded_scopes","admission_blockers","valid_until","observed_at"],
      "properties":{
        "status":{"enum":["Ready","Degraded","NotReady"]},
        "service_instance_id":{"$ref":"#/$defs/OpaqueId"},
        "service_version":{"$ref":"#/$defs/Version"},
        "api_version":{"const":"agent-runtime/v1"},
        "pi_sdk_version":{"$ref":"#/$defs/Version"},
        "runtime_profile_ref":{"$ref":"#/$defs/Reference"},
        "slot_snapshot_ref":{"$ref":"#/$defs/Reference"},
        "total_slots":{"type":"integer","minimum":0},
        "available_slots":{"type":"integer","minimum":0},
        "dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","status","version","valid_until","blocking_reasons"],"properties":{"kind":{"enum":["Tier","StateStore","Workspace","ToolRegistry"]},"status":{"enum":["Ready","Degraded","NotReady"]},"version":{"$ref":"#/$defs/Version"},"valid_until":{"$ref":"#/$defs/Timestamp"},"blocking_reasons":{"type":"array","items":{"type":"string"},"uniqueItems":true}}}},
        "compatibility_manifest_ref":{"$ref":"#/$defs/Reference"},
        "recovery_required_count":{"type":"integer","minimum":0},
        "accepting_runs":{"type":"boolean"},
        "degraded_scopes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "admission_blockers":{"type":"array","items":{"$ref":"#/$defs/Blocker"}},
        "valid_until":{"$ref":"#/$defs/Timestamp"},
        "observed_at":{"$ref":"#/$defs/Timestamp"}
      },
      "allOf":[{"if":{"properties":{"status":{"const":"NotReady"}}},"then":{"properties":{"accepting_runs":{"const":false}}}}]
    },
    "AgentRuntimeProfile": {
      "type":"object","additionalProperties":false,
      "required":["runtime_profile_id","profile_version","service_name","service_version","api_version","pi_sdk_version","compatibility_manifest_version","supported_execution_modes","supported_tool_capabilities","supported_workspace_modes","structured_result_schema_versions","checkpoint_support","cancellation_support","event_stream_support","security_policy_ref","status","valid_until","observed_at"],
      "properties":{
        "runtime_profile_id":{"$ref":"#/$defs/OpaqueId"},
        "profile_version":{"$ref":"#/$defs/Version"},
        "service_name":{"const":"Piko"},
        "service_version":{"$ref":"#/$defs/Version"},
        "api_version":{"const":"agent-runtime/v1"},
        "pi_sdk_version":{"$ref":"#/$defs/Version"},
        "compatibility_manifest_version":{"$ref":"#/$defs/Version"},
        "supported_execution_modes":{"type":"array","items":{"enum":["Single","Team"]},"minItems":1,"uniqueItems":true},
        "supported_tool_capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "supported_workspace_modes":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "structured_result_schema_versions":{"type":"array","items":{"$ref":"#/$defs/Version"},"minItems":1,"uniqueItems":true},
        "checkpoint_support":{"type":"boolean"},
        "cancellation_support":{"type":"boolean"},
        "event_stream_support":{"type":"boolean"},
        "security_policy_ref":{"$ref":"#/$defs/Reference"},
        "status":{"enum":["Ready","Degraded","NotReady","Retired"]},
        "valid_until":{"$ref":"#/$defs/Timestamp"},
        "observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "AgentSlot": {
      "type":"object","additionalProperties":false,
      "required":["agent_slot_id","slot_version","runtime_profile_ref","service_instance_id","host_ref","execution_zone","capability_tags","workspace_access_profile_refs","capacity","status","health","blocking_reasons","valid_until","observed_at"],
      "properties":{
        "agent_slot_id":{"$ref":"#/$defs/OpaqueId"},
        "slot_version":{"$ref":"#/$defs/Version"},
        "runtime_profile_ref":{"$ref":"#/$defs/Reference"},
        "service_instance_id":{"$ref":"#/$defs/OpaqueId"},
        "host_ref":{"$ref":"#/$defs/OpaqueId"},
        "execution_zone":{"type":"string","minLength":1},
        "capability_tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "workspace_access_profile_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "capacity":{"const":1},
        "status":{"enum":["Available","Claimed","Running","Recovering","Invalidated"]},
        "claimed_by_ref":{"$ref":"#/$defs/Reference"},
        "active_participant_run_ref":{"$ref":"#/$defs/Reference"},
        "health":{"enum":["Ready","Degraded","NotReady","Unknown"]},
        "blocking_reasons":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "valid_until":{"$ref":"#/$defs/Timestamp"},
        "observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "AgentSlotSnapshot": {
      "type":"object","additionalProperties":false,
      "required":["snapshot_id","snapshot_version","etag","runtime_profile_ref","service_instance_id","total","available","claimed","running","recovering","invalidated","slots","source_version","next_cursor","valid_until","observed_at"],
      "properties":{
        "snapshot_id":{"$ref":"#/$defs/OpaqueId"},"snapshot_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},"runtime_profile_ref":{"$ref":"#/$defs/Reference"},"service_instance_id":{"$ref":"#/$defs/OpaqueId"},
        "total":{"type":"integer","minimum":0},"available":{"type":"integer","minimum":0},"claimed":{"type":"integer","minimum":0},"running":{"type":"integer","minimum":0},"recovering":{"type":"integer","minimum":0},"invalidated":{"type":"integer","minimum":0},
        "slots":{"type":"array","items":{"$ref":"#/$defs/AgentSlot"}},"source_version":{"$ref":"#/$defs/Version"},"next_cursor":{"type":["string","null"]},"valid_until":{"$ref":"#/$defs/Timestamp"},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "ToolCapabilityCatalog": {
      "type":"object","additionalProperties":false,
      "required":["catalog_version","etag","runtime_profile_ref","entries","source_version","next_cursor","valid_until","observed_at"],
      "properties":{
        "catalog_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string"},"runtime_profile_ref":{"$ref":"#/$defs/Reference"},
        "entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["capability_id","capability_version","supported_operations","required_workspace_access_profile_refs","security_policy_ref","contract_test_ref","status"],"properties":{"capability_id":{"$ref":"#/$defs/OpaqueId"},"capability_version":{"$ref":"#/$defs/Version"},"supported_operations":{"type":"array","items":{"type":"string"},"uniqueItems":true},"required_workspace_access_profile_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},"security_policy_ref":{"$ref":"#/$defs/Reference"},"contract_test_ref":{"$ref":"#/$defs/Reference"},"status":{"enum":["Ready","Degraded","Unavailable"]}}}},
        "source_version":{"$ref":"#/$defs/Version"},"next_cursor":{"type":["string","null"]},"valid_until":{"$ref":"#/$defs/Timestamp"},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "DeploymentCapacityProfile": {
      "type":"object","additionalProperties":false,
      "required":["capacity_profile_id","profile_version","etag","service_instance_refs","total_agent_slots","max_team_participants","max_authenticated_clients","max_source_instances_per_client","per_client_queue_bound","host_admission_policy_ref","runtime_profile_ref","slot_snapshot_ref","valid_until","observed_at"],
      "properties":{
        "capacity_profile_id":{"$ref":"#/$defs/OpaqueId"},"profile_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string"},"service_instance_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"minItems":1,"uniqueItems":true},
        "total_agent_slots":{"type":"integer","minimum":0},"max_team_participants":{"type":"integer","minimum":1},"max_authenticated_clients":{"type":"integer","minimum":1},"max_source_instances_per_client":{"type":"integer","minimum":1},"per_client_queue_bound":{"type":"integer","minimum":0},
        "host_admission_policy_ref":{"$ref":"#/$defs/Reference"},"runtime_profile_ref":{"$ref":"#/$defs/Reference"},"slot_snapshot_ref":{"$ref":"#/$defs/Reference"},"valid_until":{"$ref":"#/$defs/Timestamp"},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "AgentRunReconciliationResult": {
      "type":"object","additionalProperties":false,
      "required":["agent_run_ref","previous_run_version","current_run_version","outcome","current_status","recovered_participant_refs","unresolved_side_effect_refs","required_actions","evidence_refs","observed_at"],
      "properties":{
        "agent_run_ref":{"$ref":"#/$defs/Reference"},"previous_run_version":{"$ref":"#/$defs/Version"},"current_run_version":{"$ref":"#/$defs/Version"},"outcome":{"enum":["Unchanged","RecoveredActive","ConfirmedTerminal","UnknownOutcome"]},"current_status":{"type":"string"},
        "previous_result_ref":{"$ref":"#/$defs/Reference"},"current_result_ref":{"$ref":"#/$defs/Reference"},"recovered_participant_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},"unresolved_side_effect_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},"required_actions":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "ParticipantRequest": {
      "type":"object",
      "additionalProperties":false,
      "required":["participant_id","role_assignment_ref","ir_ref","agent_slot_ref","expected_slot_version","tier_binding","knowledge_binding","participant_contract"],
      "properties":{
        "participant_id":{"$ref":"#/$defs/OpaqueId"},
        "role_assignment_ref":{"$ref":"#/$defs/Reference"},
        "ir_ref":{"$ref":"#/$defs/Reference"},
        "agent_slot_ref":{"$ref":"#/$defs/Reference"},
        "expected_slot_version":{"$ref":"#/$defs/Version"},
        "tier_binding":{
          "type":"object","additionalProperties":false,
          "required":["tier_base_url_ref","tier_client_ref","source_ref","source_instance_ref","tier_service_seat_ref","service_level_id","credential_binding_ref"],
          "properties":{
            "tier_base_url_ref":{"$ref":"#/$defs/OpaqueId"},
            "tier_client_ref":{"$ref":"#/$defs/OpaqueId"},
            "source_ref":{"$ref":"#/$defs/OpaqueId"},
            "source_instance_ref":{"$ref":"#/$defs/OpaqueId"},
            "tier_service_seat_ref":{"$ref":"#/$defs/Reference"},
            "service_level_id":{"$ref":"#/$defs/OpaqueId"},
            "credential_binding_ref":{"$ref":"#/$defs/OpaqueId"}
          }
        },
        "knowledge_binding":{
          "type":"object","additionalProperties":false,
          "required":["knowledge_capability_profile_ref","skill_plan_ref","experience_refs","context_bundle_ref"],
          "properties":{
            "knowledge_capability_profile_ref":{"$ref":"#/$defs/Reference"},
            "skill_plan_ref":{"$ref":"#/$defs/Reference"},
            "experience_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
            "context_bundle_ref":{"$ref":"#/$defs/Reference"}
          }
        },
        "participant_contract":{
          "type":"object","additionalProperties":false,
          "required":["responsibility","expected_outputs","write_permission","independence_requirements"],
          "properties":{
            "responsibility":{"type":"string","minLength":1,"maxLength":4096},
            "expected_outputs":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
            "write_permission":{"enum":["None","CandidateOnly","Workspace"]},
            "independence_requirements":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true}
          }
        }
      }
    },
    "ExecutionPackage": {
      "type":"object",
      "additionalProperties":false,
      "required":["manifest_path","manifest_digest","workspace_lease_ref","workspace_root","base_revision","workspace_access_profile_ref","workspace_host_binding_ref","allowed_read_roots","allowed_write_roots","input_artifact_entries","output_staging_root"],
      "properties":{
        "manifest_path":{"type":"string","minLength":1},
        "manifest_digest":{"$ref":"#/$defs/Digest","x-digest-scope":"按 RFC 8785 序列化并排除 manifest_digest 自身；entry content digest 使用原始字节"},
        "workspace_lease_ref":{"$ref":"#/$defs/Reference"},
        "workspace_root":{"type":"string","minLength":1},
        "base_revision":{"type":"string","minLength":1},
        "workspace_access_profile_ref":{"$ref":"#/$defs/Reference"},
        "workspace_host_binding_ref":{"$ref":"#/$defs/Reference"},
        "allowed_read_roots":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
        "allowed_write_roots":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "input_artifact_entries":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "output_staging_root":{"type":"string","minLength":1},
        "expiration":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "ToolBinding": {
      "type":"object","additionalProperties":false,
      "required":["binding_ref","capability","allowed_operations","policy_ref"],
      "properties":{
        "binding_ref":{"$ref":"#/$defs/Reference"},
        "capability":{"type":"string","minLength":1},
        "allowed_operations":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
        "policy_ref":{"$ref":"#/$defs/Reference"}
      }
    },
    "RunBudget": {
      "type":"object","additionalProperties":false,
      "required":["deadline","max_duration_seconds","max_tier_invocations","max_input_tokens","max_output_tokens","max_tool_calls","max_internal_repairs","cost_budget_ref"],
      "properties":{
        "deadline":{"$ref":"#/$defs/Timestamp"},
        "max_duration_seconds":{"type":"integer","minimum":1},
        "max_tier_invocations":{"type":"integer","minimum":0},
        "max_input_tokens":{"type":"integer","minimum":0},
        "max_output_tokens":{"type":"integer","minimum":0},
        "max_tool_calls":{"type":"integer","minimum":0},
        "max_internal_repairs":{"type":"integer","minimum":0},
        "cost_budget_ref":{"$ref":"#/$defs/Reference"}
      }
    },
    "AgentTaskRequest": {
      "type":"object","additionalProperties":false,
      "required":["api_version","schema_version","request_id","idempotency_key","request_digest","client_id","source_instance_id","project_id","planned_work_id","work_execution_id","attempt_id","goal","work_type","priority","execution_mode","participants","execution_package","tool_bindings","output_artifact_contracts","acceptance_contract_ref","required_validation_commands","review_policy_ref","repair_budget","run_budget","trace_context"],
      "properties":{
        "api_version":{"const":"agent-runtime/v1"},
        "schema_version":{"const":"agent-runtime-schema/v0.2"},
        "request_id":{"$ref":"#/$defs/OpaqueId"},
        "idempotency_key":{"$ref":"#/$defs/OpaqueId"},
        "request_digest":{"$ref":"#/$defs/Digest","x-digest-scope":"按 RFC 8785 序列化 request body，并排除 request_digest 自身"},
        "client_id":{"$ref":"#/$defs/OpaqueId"},
        "source_instance_id":{"$ref":"#/$defs/OpaqueId"},
        "project_id":{"$ref":"#/$defs/OpaqueId"},
        "planned_work_id":{"$ref":"#/$defs/OpaqueId"},
        "work_execution_id":{"$ref":"#/$defs/OpaqueId"},
        "attempt_id":{"$ref":"#/$defs/OpaqueId"},
        "goal":{"type":"string","minLength":1,"maxLength":32768},
        "work_type":{"type":"string","minLength":1,"maxLength":128},
        "priority":{"type":"string","minLength":1,"maxLength":32},
        "execution_mode":{"enum":["Single","Team"]},
        "team_plan_ref":{"$ref":"#/$defs/Reference"},
        "participants":{"type":"array","items":{"$ref":"#/$defs/ParticipantRequest"},"minItems":1,"uniqueItems":true},
        "execution_package":{"$ref":"#/$defs/ExecutionPackage"},
        "tool_bindings":{"type":"array","items":{"$ref":"#/$defs/ToolBinding"},"uniqueItems":true},
        "output_artifact_contracts":{"type":"array","items":{"$ref":"#/$defs/Reference"},"minItems":1,"uniqueItems":true},
        "acceptance_contract_ref":{"$ref":"#/$defs/Reference"},
        "required_validation_commands":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "review_policy_ref":{"$ref":"#/$defs/Reference"},
        "repair_budget":{"type":"integer","minimum":0},
        "run_budget":{"$ref":"#/$defs/RunBudget"},
        "trace_context":{"type":"object","additionalProperties":true}
      },
      "allOf":[
        {"if":{"properties":{"execution_mode":{"const":"Single"}}},"then":{"properties":{"participants":{"maxItems":1}}}},
        {"if":{"properties":{"execution_mode":{"const":"Team"}}},"then":{"required":["team_plan_ref"]}}
      ]
    },
    "AgentRun": {
      "type":"object","additionalProperties":false,
      "required":["agent_run_id","run_version","client_id","source_instance_id","project_id","planned_work_id","work_execution_id","attempt_id","execution_mode","status","request_digest","idempotency_key","participant_run_refs","tier_invocation_refs","tool_invocation_refs","accepted_at","updated_at"],
      "properties":{
        "agent_run_id":{"$ref":"#/$defs/OpaqueId"},
        "run_version":{"type":"integer","minimum":1},
        "client_id":{"$ref":"#/$defs/OpaqueId"},
        "source_instance_id":{"$ref":"#/$defs/OpaqueId"},
        "project_id":{"$ref":"#/$defs/OpaqueId"},
        "planned_work_id":{"$ref":"#/$defs/OpaqueId"},
        "work_execution_id":{"$ref":"#/$defs/OpaqueId"},
        "attempt_id":{"$ref":"#/$defs/OpaqueId"},
        "execution_mode":{"enum":["Single","Team"]},
        "status":{"enum":["Accepted","Queued","Preparing","Running","Finalizing","Succeeded","Failed","Cancelled","TimedOut","UnknownOutcome"]},
        "request_digest":{"$ref":"#/$defs/Digest"},
        "idempotency_key":{"$ref":"#/$defs/OpaqueId"},
        "participant_run_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "tier_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "tool_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "checkpoint_ref":{"$ref":"#/$defs/Reference"},
        "result_ref":{"$ref":"#/$defs/Reference"},
        "error_summary":{"$ref":"#/$defs/ErrorDescriptor"},
        "accepted_at":{"$ref":"#/$defs/Timestamp"},
        "started_at":{"$ref":"#/$defs/Timestamp"},
        "completed_at":{"$ref":"#/$defs/Timestamp"},
        "updated_at":{"$ref":"#/$defs/Timestamp"}
      },
      "allOf":[
        {"if":{"properties":{"status":{"enum":["Succeeded","Failed","Cancelled","TimedOut","UnknownOutcome"]}}},"then":{"required":["result_ref","completed_at"]}}
      ]
    },
    "ParticipantResult": {
      "type":"object","additionalProperties":false,
      "required":["participant_id","participant_run_ref","ir_ref","role_assignment_ref","terminal_status","output_refs","finding_refs","evidence_refs","tier_invocation_refs","tool_invocation_refs"],
      "properties":{
        "participant_id":{"$ref":"#/$defs/OpaqueId"},
        "participant_run_ref":{"$ref":"#/$defs/Reference"},
        "ir_ref":{"$ref":"#/$defs/Reference"},
        "role_assignment_ref":{"$ref":"#/$defs/Reference"},
        "terminal_status":{"enum":["Succeeded","Failed","Cancelled","TimedOut","UnknownOutcome"]},
        "output_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "finding_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "tier_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "tool_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true}
      }
    },
    "AgentTaskResult": {
      "type":"object","additionalProperties":false,
      "required":["api_version","schema_version","result_version","agent_run_id","run_version","work_execution_id","attempt_id","request_digest","terminal_status","execution_summary","participant_results","artifact_candidate_refs","validation_execution_refs","evidence_refs","tier_invocation_refs","tool_invocation_refs","usage_summary","unresolved_side_effect_refs","completed_at","result_digest"],
      "properties":{
        "api_version":{"const":"agent-runtime/v1"},
        "schema_version":{"const":"agent-runtime-schema/v0.2"},
        "result_version":{"type":"integer","minimum":1},
        "agent_run_id":{"$ref":"#/$defs/OpaqueId"},
        "run_version":{"type":"integer","minimum":1},
        "work_execution_id":{"$ref":"#/$defs/OpaqueId"},
        "attempt_id":{"$ref":"#/$defs/OpaqueId"},
        "request_digest":{"$ref":"#/$defs/Digest"},
        "terminal_status":{"enum":["Succeeded","Failed","Cancelled","TimedOut","UnknownOutcome"]},
        "execution_summary":{"type":"string","minLength":1,"maxLength":32768},
        "participant_results":{"type":"array","items":{"$ref":"#/$defs/ParticipantResult"},"minItems":1},
        "artifact_candidate_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "code_change_set_ref":{"$ref":"#/$defs/Reference"},
        "review_finding_set_ref":{"$ref":"#/$defs/Reference"},
        "review_coverage_manifest_ref":{"$ref":"#/$defs/Reference"},
        "validation_execution_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "blocker":{"$ref":"#/$defs/Blocker"},
        "tier_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "tool_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "usage_summary":{"type":"object","additionalProperties":true},
        "unresolved_side_effect_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "error":{"$ref":"#/$defs/ErrorDescriptor"},
        "supersedes_result_ref":{"$ref":"#/$defs/Reference"},
        "completed_at":{"$ref":"#/$defs/Timestamp"},
        "result_digest":{"$ref":"#/$defs/Digest","x-digest-scope":"按 RFC 8785 序列化 Result，并排除 result_digest 自身"}
      },
      "allOf":[
        {"if":{"properties":{"terminal_status":{"const":"Succeeded"}}},"then":{"properties":{"unresolved_side_effect_refs":{"maxItems":0}},"not":{"anyOf":[{"required":["error"]},{"required":["blocker"]}]}}},
        {"if":{"properties":{"terminal_status":{"const":"Failed"}}},"then":{"required":["error"],"properties":{"unresolved_side_effect_refs":{"maxItems":0}}}},
        {"if":{"properties":{"terminal_status":{"enum":["Cancelled","TimedOut"]}}},"then":{"required":["error"],"properties":{"unresolved_side_effect_refs":{"maxItems":0},"evidence_refs":{"minItems":1}}}},
        {"if":{"properties":{"terminal_status":{"const":"UnknownOutcome"}}},"then":{"properties":{"unresolved_side_effect_refs":{"minItems":1}},"anyOf":[{"required":["error"]},{"required":["blocker"]}]}}
      ]
    },
    "AgentEvent": {
      "type":"object","additionalProperties":false,
      "required":["event_id","sequence","event_version","agent_run_id","run_version","event_type","correlation_id","occurred_at"],
      "properties":{
