{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piko.local/schemas/piko-runtime-config-v0.3.schema.json",
  "title": "Piko Runtime v0.3 instance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "listen",
    "api_auth",
    "task_store",
    "pi",
    "agent",
    "workspace",
    "tools",
    "matrix",
    "llmtier",
    "queue",
    "retention",
    "observability",
    "transfer"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "api_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "principal_id",
        "bearer_token_secret_ref"
      ],
      "properties": {
        "mode": {
          "const": "bearer"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "bearer_token_secret_ref": {
          "$ref": "#/$defs/secretRef"
        }
      }
    },
    "task_store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sqlite_path",
        "busy_timeout_ms"
      ],
      "properties": {
        "sqlite_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "busy_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "session_root"
      ],
      "properties": {
        "version": {
          "const": "0.85.1"
        },
        "commit": {
          "const": "9767ba275f3e9a5ee0f5c5342249b629ab1b2282"
        },
        "session_root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "profile_ref"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "profile_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "staging_root"
      ],
      "properties": {
        "roots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "staging_root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_registry_path"
      ],
      "properties": {
        "profile_registry_path": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "homeserver": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "user_id": {
          "type": "string",
          "pattern": "^@[^:]+:.+$"
        },
        "access_token_secret_ref": {
          "$ref": "#/$defs/secretRef"
        },
        "direct_access_token": {
          "type": "string",
          "minLength": 1
        },
        "sync_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "max_media_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "allowed_mime_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
              "then": {
                "required": [
                  "homeserver",
                  "user_id",
                  "sync_timeout_ms",
                  "max_media_bytes",
                  "allowed_mime_types"
                ],
                "anyOf": [
                  {
                    "required": ["access_token_secret_ref"]
                  },
                  {
                    "required": ["direct_access_token"]
                  }
                ]
          }
        }
      ]
    },
    "llmtier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "api_key_secret_ref",
        "models_timeout_ms"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "api_key_secret_ref": {
          "$ref": "#/$defs/secretRef"
        },
        "models_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_query_days"
      ],
      "properties": {
        "minimum_query_days": {
          "type": "integer",
          "minimum": 7
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_level",
        "metrics_enabled"
      ],
      "properties": {
        "log_level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "metrics_enabled": {
          "type": "boolean"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "target_allowlist",
        "max_input_bytes",
        "retry"
      ],
      "properties": {
        "method": {
          "enum": [
            "scp",
            "mount",
            "object_store"
          ]
        },
        "credential_ref": {
          "$ref": "#/$defs/secretRef"
        },
        "port": {
          "description": "Non-default SSH port for scp. Omit for 22. Host keys remain pinned via known_hosts.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "target_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_hosts": {
          "$ref": "#/$defs/absolutePath"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "base_delay_ms"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "base_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "memory"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,63}$",
          "description": "Role of this Piko instance (e.g. 'tester', 'developer'). Used for skill experience per-role isolation."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "description": "Human-readable identity (e.g. 'alice:tester')."
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "api_key_secret_ref"],
          "properties": {
            "provider": {
              "const": "mem0",
              "description": "V0.1: hard-code 'mem0'. Future versions may support other backends."
            },
            "api_key_secret_ref": {
              "$ref": "#/$defs/secretRef",
              "description": "Secret ref for Mem0 API key. Use env:XXX or file:XXX. Resolved at startup via config.resolveSecret."
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "description": "Mem0 base URL. Omit for Cloud (default https://api.mem0.ai). Required for self-hosted."
            },
            "user_id_template": {
              "type": "string",
              "default": "${role}:${project_name}",
              "description": "Template for Mem0 user_id. V0.1 only supports ${role} and ${project_name}."
            }
          }
        },
        "doc_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "api_key_secret_ref", "base_url"],
          "description": "V0.1 optional. Project-wide document corpus search via GraphRAG-style backend. Sibling to `memory` (different scope: per-role short lessons vs project-wide docs).",
          "properties": {
            "provider": {
              "const": "graphrag",
              "description": "V0.1: hard-code 'graphrag'. Future versions may support other doc-search backends."
            },
            "api_key_secret_ref": {
              "$ref": "#/$defs/secretRef",
              "description": "Secret ref for the GraphRAG backend API key. Use env:XXX or file:XXX. Resolved at startup via config.resolveSecret."
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "description": "Base URL of the GraphRAG-style backend (e.g. 'https://graphrag.internal:8000' or your self-hosted host). REQUIRED — no Cloud default in V0.1; operators must deploy/run an HTTP service matching the contract documented in docs/20_system_design/mechanisms/piko-doc-search.md."
            },
            "default_scope": {
              "type": "string",
              "default": "all",
              "description": "Default scope for graphrag_search when the agent does not pass one. Backend-defined ('piko-design-docs' / 'std-templates' / 'all')."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "secretRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(env|file|keychain|vault):[^\\s]+$"
    }
  }
}