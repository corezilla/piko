{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://piko.local/schemas/piko-runtime-config-v0.3.schema.json",
 "title": "Piko Runtime v0.3 instance configuration",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "instance_id",
  "listen",
  "api_auth",
  "task_store",
  "pi",
  "agent",
  "workspace",
  "tools",
  "matrix",
  "llmtier",
  "queue",
  "retention",
  "observability"
 ],
 "properties": {
  "instance_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._:-]{1,128}$"
  },
  "listen": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "host",
    "port"
   ],
   "properties": {
    "host": {
     "type": "string",
     "minLength": 1
    },
    "port": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65535
    }
   }
  },
  "api_auth": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mode",
    "principal_id",
    "bearer_token_secret_ref"
   ],
   "properties": {
    "mode": {
     "const": "bearer"
    },
    "principal_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "bearer_token_secret_ref": {
     "$ref": "#/$defs/secretRef"
    }
   }
  },
  "task_store": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sqlite_path",
    "busy_timeout_ms"
   ],
   "properties": {
    "sqlite_path": {
     "$ref": "#/$defs/absolutePath"
    },
    "busy_timeout_ms": {
     "type": "integer",
     "minimum": 100,
     "maximum": 60000
    }
   }
  },
  "pi": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "commit",
    "session_root",
    "adapter_patch_manifest_path",
    "adapter_patch_sha256"
   ],
   "properties": {
    "version": {
     "const": "0.85.1"
    },
    "commit": {
     "const": "9767ba275f3e9a5ee0f5c5342249b629ab1b2282"
    },
    "session_root": {
     "$ref": "#/$defs/absolutePath"
    },
    "adapter_patch_manifest_path": {
     "$ref": "#/$defs/absolutePath"
    },
    "adapter_patch_sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "agent": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "model",
    "profile_ref"
   ],
   "properties": {
    "model": {
     "type": "string",
     "minLength": 1
    },
    "profile_ref": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "workspace": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "roots",
    "staging_root"
   ],
   "properties": {
    "roots": {
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {
      "$ref": "#/$defs/absolutePath"
     }
    },
    "staging_root": {
     "$ref": "#/$defs/absolutePath"
    }
   }
  },
  "tools": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "profile_registry_path"
   ],
   "properties": {
    "profile_registry_path": {
     "$ref": "#/$defs/absolutePath"
    }
   }
  },
  "matrix": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "enabled"
   ],
   "properties": {
    "enabled": {
     "type": "boolean"
    },
    "homeserver": {
     "type": "string",
     "format": "uri",
     "pattern": "^https://"
    },
    "user_id": {
     "type": "string",
     "pattern": "^@[^:]+:.+$"
    },
    "access_token_secret_ref": {
     "$ref": "#/$defs/secretRef"
    },
    "sync_timeout_ms": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 120000
    },
    "max_media_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1073741824
    },
    "allowed_mime_types": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "enabled": {
        "const": true
       }
      },
      "required": [
       "enabled"
      ]
     },
     "then": {
      "required": [
       "homeserver",
       "user_id",
       "access_token_secret_ref",
       "sync_timeout_ms",
       "max_media_bytes",
       "allowed_mime_types"
      ]
     }
    }
   ]
  },
  "llmtier": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "base_url",
    "api_key_secret_ref",
    "models_timeout_ms"
   ],
   "properties": {
    "base_url": {
     "type": "string",
     "format": "uri",
     "pattern": "^https?://"
    },
    "api_key_secret_ref": {
     "$ref": "#/$defs/secretRef"
    },
    "models_timeout_ms": {
     "type": "integer",
     "minimum": 100,
     "maximum": 60000
    }
   }
  },
  "queue": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "capacity"
   ],
   "properties": {
    "capacity": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100000
    }
   }
  },
  "retention": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "minimum_query_days"
   ],
   "properties": {
    "minimum_query_days": {
     "type": "integer",
     "minimum": 7
    }
   }
  },
  "observability": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "log_level",
    "metrics_enabled"
   ],
   "properties": {
    "log_level": {
     "enum": [
      "debug",
      "info",
      "warn",
      "error"
     ]
    },
    "metrics_enabled": {
     "type": "boolean"
    }
   }
  }
 },
 "$defs": {
  "absolutePath": {
   "type": "string",
   "minLength": 1,
   "pattern": "^/"
  },
  "secretRef": {
   "type": "string",
   "minLength": 1,
   "pattern": "^(env|file|keychain|vault):[^\\s]+$"
  }
 }
}
