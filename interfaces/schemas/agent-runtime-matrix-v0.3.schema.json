{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piko.local/schemas/agent-runtime-matrix-v0.3.schema.json",
  "title": "Piko 智能体运行时 Matrix/Element 增量契约",
  "description": "v0.3 中文评审草案；扩展 agent-runtime v0.2，不代表已实现。",
  "$defs": {
    "OpaqueId": {"type":"string","minLength":1,"maxLength":256},
    "Version": {"oneOf":[{"type":"integer","minimum":1},{"type":"string","minLength":1,"maxLength":256}]},
    "Timestamp": {"type":"string","format":"date-time"},
    "Reference": {
      "type":"object","additionalProperties":false,"required":["id","version"],
      "properties":{"id":{"$ref":"#/$defs/OpaqueId"},"version":{"$ref":"#/$defs/Version"}}
    },
    "IrReference": {
      "type":"object","additionalProperties":false,"required":["ir_id","ir_version"],
      "properties":{"ir_id":{"$ref":"#/$defs/OpaqueId"},"ir_version":{"$ref":"#/$defs/Version"}}
    },
    "BlockingReason": {
      "type":"object","additionalProperties":false,"required":["code","affected_scope","retryable"],
      "properties":{"code":{"type":"string","minLength":1,"maxLength":128},"affected_scope":{"type":"string","minLength":1,"maxLength":512},"retryable":{"type":"boolean"},"details_ref":{"$ref":"#/$defs/OpaqueId"}}
    },
    "ResolutionPoint": {
      "type":"object","additionalProperties":false,"required":["point_id","statement","evidence_refs"],
      "properties":{"point_id":{"$ref":"#/$defs/OpaqueId"},"statement":{"type":"string","minLength":1,"maxLength":8192},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true}}
    },
    "DisagreementItem": {
      "type":"object","additionalProperties":false,"required":["disagreement_id","statement","evidence_refs"],
      "properties":{"disagreement_id":{"$ref":"#/$defs/OpaqueId"},"statement":{"type":"string","minLength":1,"maxLength":8192},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true}}
    },
    "ParticipantResolutionPosition": {
      "type":"object","additionalProperties":false,"required":["participant_ir_ref","position","rationale","evidence_refs"],
      "properties":{"participant_ir_ref":{"$ref":"#/$defs/IrReference"},"position":{"type":"string","minLength":1,"maxLength":8192},"rationale":{"type":"string","minLength":1,"maxLength":16384},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true}}
    },
    "CollaborationResolutionSummary": {
      "type":"object","additionalProperties":false,
      "required":["resolution_ref","collaboration_session_ref","status","agreed_points","disagreement_items","participant_positions","attempted_resolution_refs","evidence_refs","recommended_next_step"],
      "properties":{
        "resolution_ref":{"$ref":"#/$defs/Reference"},"collaboration_session_ref":{"$ref":"#/$defs/Reference"},
        "status":{"enum":["Resolved","NeedsExpert","NeedsProjectManager","NeedsParticipantDecision","Blocked"]},
        "agreed_points":{"type":"array","items":{"$ref":"#/$defs/ResolutionPoint"},"uniqueItems":true},
        "disagreement_items":{"type":"array","items":{"$ref":"#/$defs/DisagreementItem"},"uniqueItems":true},
        "participant_positions":{"type":"array","items":{"$ref":"#/$defs/ParticipantResolutionPosition"},"minItems":1,"uniqueItems":true},
        "attempted_resolution_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "recommended_next_step":{"type":"string","minLength":1,"maxLength":8192}
      },
      "allOf":[
        {"if":{"properties":{"status":{"const":"Resolved"}}},"then":{"properties":{"disagreement_items":{"maxItems":0}}}},
        {"if":{"properties":{"status":{"enum":["NeedsExpert","NeedsProjectManager","NeedsParticipantDecision","Blocked"]}}},"then":{"properties":{"disagreement_items":{"minItems":1}}}}
      ],
      "x-semantic-constraints":[
        "participant_positions 的 participant_ir_ref 集合必须与 CollaborationContract participant_ir_refs 精确相等",
        "不得根据多数票、最后一条消息或 transcript 自动生成或覆盖 position",
        "recommended_next_step 不授予创建 Expert/PM Work、ParticipantActionRequest、用户 Decision、Plan change 或 Artifact acceptance 的权限"
      ]
    },
    "MatrixTransportProfileRequest": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","matrix_homeserver_url","element_web_base_url","identity_provisioning_mode","credential_binding_ref","room_topology","encryption_policy","federation_policy","allowed_element_origins","allowed_retention_policy_refs","enabled"],
      "properties":{
        "schema_version":{"const":"agent-runtime-matrix/v0.3"},
        "matrix_homeserver_url":{"type":"string","format":"uri","pattern":"^https://"},
        "element_web_base_url":{"type":"string","format":"uri","pattern":"^https://"},
        "identity_provisioning_mode":{"const":"ApplicationServiceVirtualUser"},
        "credential_binding_ref":{"$ref":"#/$defs/OpaqueId"},
        "room_topology":{"const":"ExclusiveRoom"},
        "encryption_policy":{"const":"Forbidden"},
        "federation_policy":{"const":"Forbidden"},
        "allowed_element_origins":{"type":"array","items":{"type":"string","format":"uri"},"uniqueItems":true},
        "allowed_retention_policy_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"minItems":1,"uniqueItems":true},
        "enabled":{"type":"boolean"}
      }
    },
    "MatrixTransportProfileResult": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","transport_profile_id","transport_profile_version","etag","matrix_homeserver_url","element_web_base_url","identity_provisioning_mode","credential_binding_ref","room_topology","encryption_policy","federation_policy","allowed_element_origins","allowed_retention_policy_refs","enabled","status","blocking_reasons","valid_until","observed_at","created_at","updated_at"],
      "properties":{
        "schema_version":{"const":"agent-runtime-matrix/v0.3"},
        "transport_profile_id":{"$ref":"#/$defs/OpaqueId"},"transport_profile_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},
        "matrix_homeserver_url":{"type":"string","format":"uri","pattern":"^https://"},"element_web_base_url":{"type":"string","format":"uri","pattern":"^https://"},
        "identity_provisioning_mode":{"const":"ApplicationServiceVirtualUser"},"credential_binding_ref":{"$ref":"#/$defs/OpaqueId"},
        "room_topology":{"const":"ExclusiveRoom"},"encryption_policy":{"const":"Forbidden"},"federation_policy":{"const":"Forbidden"},
        "allowed_element_origins":{"type":"array","items":{"type":"string","format":"uri"},"uniqueItems":true},
        "allowed_retention_policy_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"minItems":1,"uniqueItems":true},"enabled":{"type":"boolean"},
        "status":{"enum":["Ready","Degraded","NotReady","Disabled"]},"blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},
        "valid_until":{"$ref":"#/$defs/Timestamp"},"observed_at":{"$ref":"#/$defs/Timestamp"},"created_at":{"$ref":"#/$defs/Timestamp"},"updated_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "MatrixTransportProbeRequest": {
      "type":"object","additionalProperties":false,"required":["correlation_id"],
      "properties":{"correlation_id":{"$ref":"#/$defs/OpaqueId"}}
    },
    "MatrixTransportProbeResult": {
      "type":"object","additionalProperties":false,
      "required":["transport_profile_ref","outcome","checks","blocking_reasons","observed_at"],
      "properties":{
        "transport_profile_ref":{"$ref":"#/$defs/Reference"},"outcome":{"enum":["Ready","Degraded","NotReady"]},
        "checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","outcome"],"properties":{"name":{"type":"string","minLength":1},"outcome":{"enum":["Passed","Failed","Unknown"]},"evidence_ref":{"$ref":"#/$defs/OpaqueId"}}}},
        "blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "DisplayProfile": {
      "type":"object","additionalProperties":false,"required":["display_name","display_profile_version"],
      "properties":{"display_name":{"type":"string","minLength":1,"maxLength":255},"display_profile_version":{"$ref":"#/$defs/Version"}}
    },
    "IRCommunicationBindingRequest": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","ir_ref","display_profile","transport_profile_ref","expected_transport_profile_version","desired_status","correlation_id"],
      "properties":{
        "schema_version":{"const":"agent-runtime-matrix/v0.3"},"ir_ref":{"$ref":"#/$defs/IrReference"},"display_profile":{"$ref":"#/$defs/DisplayProfile"},
        "transport_profile_ref":{"$ref":"#/$defs/OpaqueId"},"expected_transport_profile_version":{"$ref":"#/$defs/Version"},
        "desired_status":{"enum":["Active","Suspended"]},"correlation_id":{"$ref":"#/$defs/OpaqueId"}
      }
    },
    "IRCommunicationBindingResult": {
      "type":"object","additionalProperties":false,
      "required":["communication_binding_id","binding_version","etag","client_id","project_id","ir_ref","ir_display_name","ir_display_profile_version","logical_communication_identity_ref","matrix_identity_binding_ref","matrix_user_id","matrix_display_name","transport_profile_ref","transport_profile_version","status","blocking_reasons","valid_until","observed_at","created_at","updated_at"],
      "properties":{
        "communication_binding_id":{"$ref":"#/$defs/OpaqueId"},"binding_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},
        "client_id":{"$ref":"#/$defs/OpaqueId"},"project_id":{"$ref":"#/$defs/OpaqueId"},"ir_ref":{"$ref":"#/$defs/IrReference"},
        "ir_display_name":{"type":"string","minLength":1,"maxLength":255},"ir_display_profile_version":{"$ref":"#/$defs/Version"},
        "logical_communication_identity_ref":{"$ref":"#/$defs/OpaqueId"},"matrix_identity_binding_ref":{"$ref":"#/$defs/OpaqueId"},
        "matrix_user_id":{"type":"string","pattern":"^@[^:]+:.+$"},"matrix_display_name":{"type":"string","minLength":1,"maxLength":255},
        "transport_profile_ref":{"$ref":"#/$defs/OpaqueId"},"transport_profile_version":{"$ref":"#/$defs/Version"},"status":{"enum":["Active","Suspended"]},
        "blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},"valid_until":{"$ref":"#/$defs/Timestamp"},
        "observed_at":{"$ref":"#/$defs/Timestamp"},"created_at":{"$ref":"#/$defs/Timestamp"},"updated_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "ParticipantRoute": {
      "type":"object","additionalProperties":false,"required":["from_ir_ref","to_ir_ref"],
      "properties":{"from_ir_ref":{"$ref":"#/$defs/IrReference"},"to_ir_ref":{"$ref":"#/$defs/IrReference"}}
    },
    "ReplyRequirement": {
      "type":"object","additionalProperties":false,"required":["requirement_id","requester_ir_ref","required_responder_ir_refs"],
      "properties":{"requirement_id":{"$ref":"#/$defs/OpaqueId"},"requester_ir_ref":{"$ref":"#/$defs/IrReference"},"required_responder_ir_refs":{"type":"array","items":{"$ref":"#/$defs/IrReference"},"minItems":1,"uniqueItems":true}}
    },
    "MessageDeadline": {
      "type":"object","additionalProperties":false,"required":["requirement_id","deadline"],
      "properties":{"requirement_id":{"$ref":"#/$defs/OpaqueId"},"deadline":{"$ref":"#/$defs/Timestamp"}}
    },
    "CollaborationContract": {
      "type":"object","additionalProperties":false,
      "required":["mode","collaboration_contract_id","contract_version","transport_profile_ref","transport_profile_version","participant_ir_refs","observer_binding_refs","allowed_participant_routes","reply_requirements","message_deadlines","routing_policy_ref","retention_policy_ref","close_policy"],
      "properties":{
        "mode":{"const":"ExclusiveRoom"},"collaboration_contract_id":{"$ref":"#/$defs/OpaqueId"},"contract_version":{"$ref":"#/$defs/Version"},
        "transport_profile_ref":{"$ref":"#/$defs/OpaqueId"},"transport_profile_version":{"$ref":"#/$defs/Version"},
        "participant_ir_refs":{"type":"array","items":{"$ref":"#/$defs/IrReference"},"minItems":1,"uniqueItems":true},
        "observer_binding_refs":{"type":"array","items":{"$ref":"#/$defs/Reference"},"uniqueItems":true},
        "allowed_participant_routes":{"type":"array","items":{"$ref":"#/$defs/ParticipantRoute"},"uniqueItems":true},
        "reply_requirements":{"type":"array","items":{"$ref":"#/$defs/ReplyRequirement"},"uniqueItems":true},
        "message_deadlines":{"type":"array","items":{"$ref":"#/$defs/MessageDeadline"},"uniqueItems":true},
        "routing_policy_ref":{"$ref":"#/$defs/Reference"},"retention_policy_ref":{"$ref":"#/$defs/Reference"},"close_policy":{"const":"RuntimeIntent"}
      }
    },
    "AgentTaskRequestCollaborationExtension": {
      "type":"object","additionalProperties":false,"required":["collaboration_contract"],
      "properties":{"collaboration_contract":{"$ref":"#/$defs/CollaborationContract"}},
      "description":"合并进入 agent-runtime v0.3 AgentTaskRequest 的必填字段；不是独立请求或第二个 endpoint。"
    },
    "CollaborationParticipantDescriptor": {
      "type":"object","additionalProperties":false,"required":["ir_ref","display_name","display_profile_version","matrix_user_id","role_assignment_ref","participant_run_ref"],
      "properties":{"ir_ref":{"$ref":"#/$defs/IrReference"},"display_name":{"type":"string","minLength":1},"display_profile_version":{"$ref":"#/$defs/Version"},"matrix_user_id":{"type":"string","pattern":"^@[^:]+:.+$"},"role_assignment_ref":{"$ref":"#/$defs/Reference"},"participant_run_ref":{"$ref":"#/$defs/Reference"}}
    },
    "ElementConversationDescriptor": {
      "type":"object","additionalProperties":false,
      "required":["descriptor_version","etag","client_id","project_id","collaboration_session_id","collaboration_session_version","agent_run_ref","work_execution_ref","attempt_ref","matrix_room_id","element_web_base_url","element_route","open_mode","allowed_embed_origin","title","participants","access_mode","status","blocking_reasons","observed_at"],
      "properties":{
        "descriptor_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},"client_id":{"$ref":"#/$defs/OpaqueId"},"project_id":{"$ref":"#/$defs/OpaqueId"},
        "collaboration_session_id":{"$ref":"#/$defs/OpaqueId"},"collaboration_session_version":{"$ref":"#/$defs/Version"},"agent_run_ref":{"$ref":"#/$defs/Reference"},
        "work_execution_ref":{"$ref":"#/$defs/Reference"},"attempt_ref":{"$ref":"#/$defs/Reference"},"matrix_room_id":{"type":"string","pattern":"^!.+:.+$"},
        "element_web_base_url":{"type":"string","format":"uri","pattern":"^https://"},"element_route":{"type":"string","minLength":1},"open_mode":{"const":"ExternalLink"},
        "allowed_embed_origin":{"type":"null"},"title":{"type":"string","minLength":1,"maxLength":255},"participants":{"type":"array","items":{"$ref":"#/$defs/CollaborationParticipantDescriptor"},"minItems":1},
        "access_mode":{"const":"UserMatrixSession"},"status":{"enum":["Active","WaitingForReply","Closed","Unavailable"]},
        "blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},"observed_at":{"$ref":"#/$defs/Timestamp"}
      }
    },
    "CollaborationSessionSummary": {
      "type":"object","additionalProperties":false,"required":["collaboration_session_id","collaboration_session_version","etag","agent_run_ref","work_execution_ref","attempt_ref","participants","matrix_room_id","status","last_message_at","blocking_reasons","latest_collaboration_resolution_ref","retention_policy_ref","pending_delivery_count","observed_at"],
      "properties":{"collaboration_session_id":{"$ref":"#/$defs/OpaqueId"},"collaboration_session_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},"agent_run_ref":{"$ref":"#/$defs/Reference"},"work_execution_ref":{"$ref":"#/$defs/Reference"},"attempt_ref":{"$ref":"#/$defs/Reference"},"participants":{"type":"array","items":{"$ref":"#/$defs/CollaborationParticipantDescriptor"},"minItems":1},"matrix_room_id":{"type":"string","pattern":"^!.+:.+$"},"status":{"enum":["Provisioning","Active","WaitingForReply","Closing","Closed","Unavailable"]},"last_message_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},"latest_collaboration_resolution_ref":{"oneOf":[{"$ref":"#/$defs/Reference"},{"type":"null"}]},"retention_policy_ref":{"$ref":"#/$defs/Reference"},"pending_delivery_count":{"type":"integer","minimum":0},"observed_at":{"$ref":"#/$defs/Timestamp"}},
      "x-forbidden-projections":["stage","planned_work","room_attention","participant_action_request","matrix_message_body","transcript","transcript_summary"]
    },
    "CollaborationSessionList": {
      "type":"object","additionalProperties":false,"required":["items","next_cursor","observed_at"],
      "properties":{"items":{"type":"array","items":{"$ref":"#/$defs/CollaborationSessionSummary"}},"next_cursor":{"type":["string","null"],"minLength":1},"observed_at":{"$ref":"#/$defs/Timestamp"}},
      "x-pagination-order":"last_message_at DESC NULLS LAST, collaboration_session_id ASC",
      "x-cursor-binds":["client_id","project_id","filter_digest","snapshot_upper_bound","last_sort_key","expires_at"]
    },
    "AgentTaskResultV03": {
      "type":"object","additionalProperties":false,
      "required":["api_version","schema_version","result_version","agent_run_id","run_version","work_execution_id","attempt_id","request_digest","terminal_status","execution_summary","participant_results","artifact_candidate_refs","validation_execution_refs","evidence_refs","tier_invocation_refs","tool_invocation_refs","usage_summary","unresolved_side_effect_refs","completed_at","result_digest"],
      "properties":{
        "api_version":{"const":"agent-runtime/v1"},"schema_version":{"const":"agent-runtime-schema/v0.3"},
        "result_version":{"type":"integer","minimum":1},"agent_run_id":{"$ref":"#/$defs/OpaqueId"},"run_version":{"type":"integer","minimum":1},
        "work_execution_id":{"$ref":"#/$defs/OpaqueId"},"attempt_id":{"$ref":"#/$defs/OpaqueId"},
        "request_digest":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Digest"},
        "terminal_status":{"enum":["Succeeded","Failed","Cancelled","TimedOut","UnknownOutcome"]},
        "execution_summary":{"type":"string","minLength":1,"maxLength":32768},
        "participant_results":{"type":"array","items":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/ParticipantResult"},"minItems":1},
        "artifact_candidate_refs":{"type":"array","items":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"uniqueItems":true},
        "code_change_set_ref":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"review_finding_set_ref":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"review_coverage_manifest_ref":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},
        "validation_execution_refs":{"type":"array","items":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"uniqueItems":true},
        "evidence_refs":{"type":"array","items":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"uniqueItems":true},
        "blocker":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Blocker"},
        "tier_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},"tool_invocation_refs":{"type":"array","items":{"$ref":"#/$defs/OpaqueId"},"uniqueItems":true},
        "usage_summary":{"type":"object","additionalProperties":true},"unresolved_side_effect_refs":{"type":"array","items":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},"uniqueItems":true},
        "error":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/ErrorDescriptor"},"supersedes_result_ref":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Reference"},
        "collaboration_resolution_summary":{"$ref":"#/$defs/CollaborationResolutionSummary"},
        "completed_at":{"$ref":"#/$defs/Timestamp"},"result_digest":{"$ref":"./agent-runtime-v0.2.schema.json#/$defs/Digest","x-digest-scope":"按 RFC 8785 序列化 Result，并排除 result_digest 自身"}
      },
      "allOf":[
        {"if":{"properties":{"terminal_status":{"const":"Succeeded"}}},"then":{"properties":{"unresolved_side_effect_refs":{"maxItems":0}},"not":{"anyOf":[{"required":["error"]},{"required":["blocker"]}]}}},
        {"if":{"properties":{"terminal_status":{"const":"Failed"}}},"then":{"required":["error"],"properties":{"unresolved_side_effect_refs":{"maxItems":0}}}},
        {"if":{"properties":{"terminal_status":{"enum":["Cancelled","TimedOut"]}}},"then":{"required":["error"],"properties":{"unresolved_side_effect_refs":{"maxItems":0},"evidence_refs":{"minItems":1}}}},
        {"if":{"properties":{"terminal_status":{"const":"UnknownOutcome"}}},"then":{"properties":{"unresolved_side_effect_refs":{"minItems":1}},"anyOf":[{"required":["error"]},{"required":["blocker"]}]}}
      ]
    },
    "CollaborationSessionCloseRequest": {
      "type":"object","additionalProperties":false,"required":["reason_code","work_execution_ref","attempt_ref","retention_policy_ref","correlation_id"],
      "properties":{"reason_code":{"type":"string","minLength":1,"maxLength":128},"work_execution_ref":{"$ref":"#/$defs/Reference"},"attempt_ref":{"$ref":"#/$defs/Reference"},"retention_policy_ref":{"$ref":"#/$defs/Reference"},"correlation_id":{"$ref":"#/$defs/OpaqueId"}}
    },
    "CollaborationSessionCloseResult": {
      "type":"object","additionalProperties":false,"required":["collaboration_session_id","previous_version","session_version","etag","outcome","pending_delivery_count","archive_execution_ref","retention_policy_ref","blocking_reasons","observed_at"],
      "properties":{"collaboration_session_id":{"$ref":"#/$defs/OpaqueId"},"previous_version":{"$ref":"#/$defs/Version"},"session_version":{"$ref":"#/$defs/Version"},"etag":{"type":"string","minLength":1},"outcome":{"enum":["Closing","Closed","Unchanged"]},"pending_delivery_count":{"type":"integer","minimum":0},"archive_execution_ref":{"$ref":"#/$defs/Reference"},"retention_policy_ref":{"$ref":"#/$defs/Reference"},"blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/BlockingReason"}},"observed_at":{"$ref":"#/$defs/Timestamp"}}
    }
  }
}
