{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piko.local/schemas/agent-runtime-v0.3.schema.json",
  "title": "Piko Agent Runtime simplified contract",
  "description": "Design-stage contract for a thin single-Agent task wrapper over Pi.",
  "x-contract-version": "0.3.0-simplified.6",
  "$defs": {
    "Identifier": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "OpaqueRef": {"type":"string","minLength":1,"maxLength":256},
    "Timestamp": {"type":"string","format":"date-time","pattern":"Z$"},
    "Digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "RelativePath": {"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*[/]$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^\\\\]+$"},

    "Permissions": {"type":"object","additionalProperties":false,"required":["read_paths","write_paths","tool_profile_ref"],"properties":{"read_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"}},"write_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"}},"tool_profile_ref":{"$ref":"#/$defs/OpaqueRef"}}},
    "DiscussionContext": {"type":"object","additionalProperties":false,"required":["room_id","trigger_event_id"],"properties":{"room_id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^!.*:.+$"},"trigger_event_id":{"type":"string","minLength":2,"maxLength":255,"pattern":"^\\$.+$"}}},

    "InputRef": {
      "type":"object","additionalProperties":false,"required":["source"],
      "properties":{
        "source":{"type":"string","minLength":1,"maxLength":4096,"description":"输入来源引用（例如 scp 'user@host:/path/doc.md' 或 Slinky 空间内的路径）。不是文件内容。"},
        "dest":{"$ref":"#/$defs/RelativePath","description":"拉取到 Piko workspace 的相对路径（相对 workspace_ref 根）；缺省取 source 的 basename。"},
        "sha256":{"$ref":"#/$defs/Digest","description":"期望摘要；给定时 Piko 拉取后必须校验。"}
      }
    },
    "ArtifactTarget": {
      "type":"object","additionalProperties":false,"required":["method","target"],
      "properties":{
        "method":{"enum":["scp","mount","object_store"],"description":"数据面方法；本期默认 scp。"},
        "target":{"type":"string","minLength":1,"maxLength":4096,"description":"投递目标：scp 为 'user@host:/path'（Slinky 预建目录）；mount 为挂载路径；object_store 为对象存储 URI。"},
        "secret_ref":{"$ref":"#/$defs/OpaqueRef","description":"凭据引用（Secret provider）；不进载荷/日志。mount 可省略。"}
      }
    },
    "InputStaging": {
      "type":"object","additionalProperties":false,"required":["state"],
      "properties":{
        "state":{"enum":["none","pending","in_progress","ready","failed"],"description":"输入预备（不占 execution slot）：none=无 input_refs；pending=未开始；in_progress=拉取中；ready=已就绪、可竞争 slot；failed=前提失败（终态 Failed）。"},
        "fetched":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/InputRef"},"description":"已拉取并校验通过的输入。"},
        "failed":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["source","error"],"properties":{"source":{"type":"string","minLength":1,"maxLength":4096},"error":{"type":"string","minLength":1,"maxLength":8192}}},"description":"拉取/校验失败的输入。"}
      }
    },

    "AgentTaskRequest": {
      "type":"object","additionalProperties":false,
      "required":["task_id","instruction","workspace_ref","permissions","output_paths"],
      "properties":{
        "task_id":{"$ref":"#/$defs/Identifier"},
        "instruction":{"type":"string","minLength":1,"maxLength":1048576},
        "workspace_ref":{"$ref":"#/$defs/OpaqueRef"},
        "permissions":{"$ref":"#/$defs/Permissions"},
        "output_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"},"description":"产出的相对路径（相对 workspace 根）。投递映射：<artifact_target.target>/<该路径>，保留相对目录结构，不重命名。"},
        "input_refs":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/InputRef"},"description":"执行前由 Piko 主动拉取的输入；文件内容不经 HTTP。"},
        "artifact_target":{"$ref":"#/$defs/ArtifactTarget","description":"产出投递目标；缺省则产出留在 Piko 本地 staging（须 Slinky 可访问）。"},
        "discussion":{"$ref":"#/$defs/DiscussionContext"}
      }
    },

    "TaskState": {"enum":["Queued","Running","Cancelling","Completed","Failed","Cancelled"]},
    "DiscussionIntakeState": {"enum":["Disabled","Open","Closing","Closed"],"description":"仅 discussion Run 使用；非 discussion Run 固定 Disabled。"},
    "Progress": {"type":"object","additionalProperties":false,"required":["model_calls","tool_calls","last_activity_at","elapsed_ms","usage_so_far","recent_actions"],"properties":{"model_calls":{"type":"integer","minimum":0,"description":"Durable Pi provider-effect attempts admitted, including Harness retries; a crash gap is conservatively counted."},"tool_calls":{"type":"integer","minimum":0},"last_activity_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"elapsed_ms":{"type":"integer","minimum":0,"description":"now - started_at；Queued 为 0。"},"usage_so_far":{"type":"object","additionalProperties":false,"required":["input_tokens","output_tokens","total_tokens"],"properties":{"input_tokens":{"type":["integer","null"],"minimum":0},"output_tokens":{"type":["integer","null"],"minimum":0},"total_tokens":{"type":["integer","null"],"minimum":0}},"description":"到目前为止累计 token（可能部分/未知）；终态以 AgentResult.usage 为准。"},"recent_actions":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/KnownAction"},"description":"（进度）最近已执行/进行中的动作，按时间倒序，最多 50 条——即‘已经做了哪些事情’。"},"current_action":{"oneOf":[{"type":"string","maxLength":4096},{"type":"null"}],"description":"当前正在执行的动作简述；空闲/未终态无在途动作时为 null。"}}},
    "TaskView": {
      "type":"object","additionalProperties":false,
      "required":["task_id","state","generation","accepted_at","started_at","finished_at","result_available","cancel_requested","discussion_intake_state","input_staging","progress","artifact_delivery"],
      "properties":{"task_id":{"$ref":"#/$defs/Identifier"},"state":{"$ref":"#/$defs/TaskState"},"generation":{"type":"integer","minimum":1,"description":"执行世代；首次为 1，恢复重派时递增。产出投递幂等键为 (task_id, generation, path, sha256)。"},"accepted_at":{"$ref":"#/$defs/Timestamp"},"started_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"finished_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"result_available":{"type":"boolean"},"cancel_requested":{"type":"boolean"},"discussion_intake_state":{"$ref":"#/$defs/DiscussionIntakeState"},"input_staging":{"$ref":"#/$defs/InputStaging","description":"输入预备状态（不占 execution slot）。"},"progress":{"$ref":"#/$defs/Progress"},"artifact_delivery":{"$ref":"#/$defs/ArtifactDelivery","description":"（Run 侧 · 可变）产出投递状态；终态后更新，不影响执行终态。"}},
      "allOf":[
        {"if":{"properties":{"state":{"const":"Queued"}},"required":["state"]},"then":{"properties":{"started_at":{"type":"null"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Running"}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Cancelling"}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":true}}}},
        {"if":{"properties":{"state":{"enum":["Completed","Failed","Cancelled"]}},"required":["state"]},"then":{"properties":{"finished_at":{"$ref":"#/$defs/Timestamp"},"result_available":{"const":true}}}},
        {"if":{"properties":{"state":{"enum":["Completed","Failed"]}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"}}}},
        {"if":{"properties":{"state":{"const":"Completed"}},"required":["state"]},"then":{"properties":{"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Cancelled"}},"required":["state"]},"then":{"properties":{"cancel_requested":{"const":true}}}}
      ]
    },
    "CancelReceipt": {"type":"object","additionalProperties":false,"required":["outcome","requested_at"],"properties":{"outcome":{"enum":["CancelledBeforeStart","StopRequested","AlreadyTerminal"]},"requested_at":{"$ref":"#/$defs/Timestamp"}}},
    "TaskStats": {
      "type":"object","additionalProperties":false,
      "required":["model_calls","tool_calls","duration_ms","outputs_count","outputs_bytes"],
      "properties":{
        "model_calls":{"type":"integer","minimum":0,"description":"逻辑模型调用次数（每次调用计 1，不含重试）。含重试的实际尝试数见 usage.model_attempts（≥ 本值）。"},
        "tool_calls":{"type":"integer","minimum":0,"description":"工具调用次数。"},
        "duration_ms":{"type":"integer","minimum":0,"description":"从 started_at 到 finished_at 的墙钟毫秒。"},
        "outputs_count":{"type":"integer","minimum":0,"description":"产出文件数。"},
        "outputs_bytes":{"type":"integer","minimum":0,"description":"产出文件总字节。"}
      }
    },
    "OutputArtifact": {"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"$ref":"#/$defs/RelativePath"},"sha256":{"$ref":"#/$defs/Digest"},"size_bytes":{"type":"integer","minimum":0}}},
    "FailedArtifact": {"type":"object","additionalProperties":false,"required":["path","error"],"properties":{"path":{"$ref":"#/$defs/RelativePath"},"error":{"type":"string","minLength":1,"maxLength":8192}}},
    "ArtifactDelivery": {
      "type":"object","additionalProperties":false,"required":["state","delivered","failed"],
      "properties":{
        "state":{"enum":["none","pending","in_progress","delivered","partial","failed"],"description":"none=未给 artifact_target；delivered=全部投递成功；partial=部分成功；failed=全部失败。"},
        "delivered":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/OutputArtifact"}},
        "failed":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/FailedArtifact"}}
      },
      "x-semantic-invariants":["delivered 与 failed 的 path 集合不相交","state=delivered 时 failed 为空","state=failed 时 delivered 为空",
  "投递失败不改变执行终态：AgentResult.failure 保持 null，投递错误仅由本对象（state=failed/partial 与 failed[]）表达","state=none 时 delivered 与 failed 均为空"]
    },
    "KnownAction": {"type":"object","additionalProperties":false,"required":["kind","status","description"],"properties":{"kind":{"enum":["ModelCall","ToolCall","FileWrite","MatrixSend","Other"]},"status":{"enum":["Completed","InProgress","Failed","Unknown"]},"description":{"type":"string","minLength":1,"maxLength":4096}}},
    "TokenField": {"enum":["input_tokens","output_tokens","total_tokens","cache_read_tokens","cache_write_tokens","reasoning_tokens"]},
    "TokenUsage": {
      "x-semantic-invariants":["usage_observed_attempts <= model_attempts","Complete implies usage_observed_attempts == model_attempts","total_tokens == input_tokens + output_tokens when all are known","cache_read_tokens and cache_write_tokens do not exceed input_tokens when known","reasoning_tokens does not exceed output_tokens when known"],
      "type":"object","additionalProperties":false,
      "required":["source","quality","input_tokens","output_tokens","total_tokens","cache_read_tokens","cache_write_tokens","reasoning_tokens","model_attempts","usage_observed_attempts","missing_fields"],
      "properties":{"source":{"const":"PiModelResponses"},"quality":{"enum":["Complete","Partial","Unknown"]},"input_tokens":{"type":["integer","null"],"minimum":0},"output_tokens":{"type":["integer","null"],"minimum":0},"total_tokens":{"type":["integer","null"],"minimum":0},"cache_read_tokens":{"type":["integer","null"],"minimum":0},"cache_write_tokens":{"type":["integer","null"],"minimum":0},"reasoning_tokens":{"type":["integer","null"],"minimum":0},"model_attempts":{"type":"integer","minimum":0},"usage_observed_attempts":{"type":"integer","minimum":0},"missing_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/TokenField"}}},
      "allOf":[
        {"if":{"properties":{"quality":{"const":"Complete"}},"required":["quality"]},"then":{"properties":{"input_tokens":{"type":"integer"},"output_tokens":{"type":"integer"},"total_tokens":{"type":"integer"},"cache_read_tokens":{"type":"integer"},"cache_write_tokens":{"type":"integer"},"reasoning_tokens":{"type":"integer"},"missing_fields":{"maxItems":0}}}},
        {"if":{"properties":{"quality":{"const":"Partial"}},"required":["quality"]},"then":{"properties":{"missing_fields":{"minItems":1,"maxItems":5}},"anyOf":[{"properties":{"input_tokens":{"type":"integer"}}},{"properties":{"output_tokens":{"type":"integer"}}},{"properties":{"total_tokens":{"type":"integer"}}},{"properties":{"cache_read_tokens":{"type":"integer"}}},{"properties":{"cache_write_tokens":{"type":"integer"}}},{"properties":{"reasoning_tokens":{"type":"integer"}}}]}},
        {"if":{"properties":{"quality":{"const":"Unknown"}},"required":["quality"]},"then":{"properties":{"input_tokens":{"type":"null"},"output_tokens":{"type":"null"},"total_tokens":{"type":"null"},"cache_read_tokens":{"type":"null"},"cache_write_tokens":{"type":"null"},"reasoning_tokens":{"type":"null"},"missing_fields":{"minItems":6,"maxItems":6}}}},
        {"if":{"properties":{"input_tokens":{"type":"null"}},"required":["input_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"input_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"input_tokens"}}}}}},
        {"if":{"properties":{"output_tokens":{"type":"null"}},"required":["output_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"output_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"output_tokens"}}}}}},
        {"if":{"properties":{"total_tokens":{"type":"null"}},"required":["total_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"total_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"total_tokens"}}}}}},
        {"if":{"properties":{"cache_read_tokens":{"type":"null"}},"required":["cache_read_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"cache_read_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"cache_read_tokens"}}}}}},
        {"if":{"properties":{"cache_write_tokens":{"type":"null"}},"required":["cache_write_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"cache_write_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"cache_write_tokens"}}}}}},
        {"if":{"properties":{"reasoning_tokens":{"type":"null"}},"required":["reasoning_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"reasoning_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"reasoning_tokens"}}}}}}
      ]
    },
    "Failure": {"type":"object","additionalProperties":false,"required":["code","cause_class","message"],"properties":{"code":{"enum":["ModelUnavailable","ModelResponseInvalid","ToolFailure","UnsafeRetryBlocked","ExecutionStateUnknown","DiscussionAccessLost","InputFetchFailed","CancelledByRequest","InternalError"]},"cause_class":{"enum":["Dependency","ModelProtocol","Tool","ExecutionUnknown","Authorization","Cancellation","Internal"]},"message":{"type":"string","minLength":1,"maxLength":8192}}},
    "AgentResult": {
      "type":"object","additionalProperties":false,
      "required":["task_id","generation","state","partial","summary","outputs","stats","known_actions","usage","failure","published_at"],
      "properties":{"task_id":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"state":{"enum":["Completed","Failed","Cancelled"]},"partial":{"type":"boolean"},"summary":{"type":"string","maxLength":1048576},"outputs":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/OutputArtifact"}},"stats":{"$ref":"#/$defs/TaskStats","description":"执行统计；token 明细仍见 usage。"},"known_actions":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/KnownAction"}},"usage":{"$ref":"#/$defs/TokenUsage"},"failure":{"oneOf":[{"$ref":"#/$defs/Failure"},{"type":"null"}]},"published_at":{"$ref":"#/$defs/Timestamp"}},
      "allOf":[
        {"if":{"properties":{"state":{"const":"Completed"}},"required":["state"]},"then":{"properties":{"failure":{"type":"null"},"partial":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Failed"}},"required":["state"]},"then":{"properties":{"failure":{"$ref":"#/$defs/Failure"}}}},
        {"if":{"properties":{"state":{"const":"Cancelled"}},"required":["state"]},"then":{"properties":{"failure":{"allOf":[{"$ref":"#/$defs/Failure"},{"properties":{"code":{"const":"CancelledByRequest"},"cause_class":{"const":"Cancellation"}}}]}}}}
      ]
    },
    "RequestErrorCode": {"enum":["InvalidRequest","Unauthorized","ScopeDenied","NotFound","TaskConflict","TaskNotTerminal","InvalidDiscussionContext","QueueFull","DependencyUnavailable","ResultUnavailable","Gone"]},
    "ErrorEnvelope": {"type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"type":"object","additionalProperties":false,"required":["code","message","request_id"],"properties":{"code":{"$ref":"#/$defs/RequestErrorCode"},"message":{"type":"string","minLength":1,"maxLength":8192},"request_id":{"type":"string","minLength":1,"maxLength":128}}}}}
  }
}
