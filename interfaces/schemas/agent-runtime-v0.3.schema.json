{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piko.local/schemas/agent-runtime-v0.3.schema.json",
  "title": "Piko Agent Runtime simplified contract",
  "description": "Design-stage contract for a thin single-Agent task wrapper over Pi.",
  "x-contract-version": "0.3.0-simplified.6",
  "$defs": {
    "Identifier": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "OpaqueRef": {"type":"string","minLength":1,"maxLength":256},
    "Timestamp": {"type":"string","format":"date-time","pattern":"Z$"},
    "Digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "RelativePath": {"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*[/]$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^\\\\]+$"},
    "Permissions": {"type":"object","additionalProperties":false,"required":["read_paths","write_paths","tool_profile_ref"],"properties":{"read_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"}},"write_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"}},"tool_profile_ref":{"$ref":"#/$defs/OpaqueRef"}}},
    "RunLimits": {"type":"object","additionalProperties":false,"required":["deadline_at","max_model_calls","max_tool_calls"],"properties":{"deadline_at":{"$ref":"#/$defs/Timestamp"},"max_model_calls":{"type":"integer","minimum":1,"maximum":100000},"max_tool_calls":{"type":"integer","minimum":0,"maximum":100000}}},
    "DiscussionContext": {"type":"object","additionalProperties":false,"required":["room_id","trigger_event_id"],"properties":{"room_id":{"type":"string","minLength":3,"maxLength":255,"pattern":"^!.*:.+$"},"trigger_event_id":{"type":"string","minLength":2,"maxLength":255,"pattern":"^\\$.+$"}}},
    "AgentTaskRequest": {"type":"object","additionalProperties":false,"required":["task_id","instruction","workspace_ref","permissions","limits","output_paths"],"properties":{"task_id":{"$ref":"#/$defs/Identifier"},"instruction":{"type":"string","minLength":1,"maxLength":1048576},"workspace_ref":{"$ref":"#/$defs/OpaqueRef"},"permissions":{"$ref":"#/$defs/Permissions"},"limits":{"$ref":"#/$defs/RunLimits"},"output_paths":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/RelativePath"}},"discussion":{"$ref":"#/$defs/DiscussionContext"}}},
    "RunState": {"enum":["Queued","Running","Cancelling","Completed","Failed","Cancelled"]},
    "Progress": {"type":"object","additionalProperties":false,"required":["model_calls","tool_calls","last_activity_at"],"properties":{"model_calls":{"type":"integer","minimum":0,"description":"Durable Pi provider-effect attempts admitted, including Harness retries; a crash gap is conservatively counted."},"tool_calls":{"type":"integer","minimum":0},"last_activity_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]}}},
    "RunView": {
      "type":"object","additionalProperties":false,
      "required":["run_id","task_id","state","accepted_at","started_at","finished_at","result_available","cancel_requested","progress"],
      "properties":{"run_id":{"$ref":"#/$defs/Identifier"},"task_id":{"$ref":"#/$defs/Identifier"},"state":{"$ref":"#/$defs/RunState"},"accepted_at":{"$ref":"#/$defs/Timestamp"},"started_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"finished_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"result_available":{"type":"boolean"},"cancel_requested":{"type":"boolean"},"progress":{"$ref":"#/$defs/Progress"}},
      "allOf":[
        {"if":{"properties":{"state":{"const":"Queued"}},"required":["state"]},"then":{"properties":{"started_at":{"type":"null"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Running"}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Cancelling"}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"},"finished_at":{"type":"null"},"result_available":{"const":false},"cancel_requested":{"const":true}}}},
        {"if":{"properties":{"state":{"enum":["Completed","Failed","Cancelled"]}},"required":["state"]},"then":{"properties":{"finished_at":{"$ref":"#/$defs/Timestamp"},"result_available":{"const":true}}}},
        {"if":{"properties":{"state":{"enum":["Completed","Failed"]}},"required":["state"]},"then":{"properties":{"started_at":{"$ref":"#/$defs/Timestamp"}}}},
        {"if":{"properties":{"state":{"const":"Completed"}},"required":["state"]},"then":{"properties":{"cancel_requested":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Cancelled"}},"required":["state"]},"then":{"properties":{"cancel_requested":{"const":true}}}}
      ]
    },
    "CancelReceipt": {"type":"object","additionalProperties":false,"required":["run_id","outcome","requested_at"],"properties":{"run_id":{"$ref":"#/$defs/Identifier"},"outcome":{"enum":["CancelledBeforeStart","StopRequested","AlreadyTerminal"]},"requested_at":{"$ref":"#/$defs/Timestamp"}}},
    "OutputArtifact": {"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"$ref":"#/$defs/RelativePath"},"sha256":{"$ref":"#/$defs/Digest"},"size_bytes":{"type":"integer","minimum":0}}},
    "KnownAction": {"type":"object","additionalProperties":false,"required":["kind","status","description"],"properties":{"kind":{"enum":["ModelCall","ToolCall","FileWrite","MatrixSend","Other"]},"status":{"enum":["Completed","Failed","Unknown"]},"description":{"type":"string","minLength":1,"maxLength":4096}}},
    "TokenField": {"enum":["input_tokens","output_tokens","total_tokens","cache_read_tokens","cache_write_tokens","reasoning_tokens"]},
    "TokenUsage": {
      "x-semantic-invariants":["usage_observed_attempts <= model_attempts","Complete implies usage_observed_attempts == model_attempts","total_tokens == input_tokens + output_tokens when all are known","cache_read_tokens and cache_write_tokens do not exceed input_tokens when known","reasoning_tokens does not exceed output_tokens when known"],
      "type":"object","additionalProperties":false,
      "required":["source","quality","input_tokens","output_tokens","total_tokens","cache_read_tokens","cache_write_tokens","reasoning_tokens","model_attempts","usage_observed_attempts","missing_fields"],
      "properties":{"source":{"const":"PiModelResponses"},"quality":{"enum":["Complete","Partial","Unknown"]},"input_tokens":{"type":["integer","null"],"minimum":0},"output_tokens":{"type":["integer","null"],"minimum":0},"total_tokens":{"type":["integer","null"],"minimum":0},"cache_read_tokens":{"type":["integer","null"],"minimum":0},"cache_write_tokens":{"type":["integer","null"],"minimum":0},"reasoning_tokens":{"type":["integer","null"],"minimum":0},"model_attempts":{"type":"integer","minimum":0},"usage_observed_attempts":{"type":"integer","minimum":0},"missing_fields":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/TokenField"}}},
      "allOf":[
        {"if":{"properties":{"quality":{"const":"Complete"}},"required":["quality"]},"then":{"properties":{"input_tokens":{"type":"integer"},"output_tokens":{"type":"integer"},"total_tokens":{"type":"integer"},"cache_read_tokens":{"type":"integer"},"cache_write_tokens":{"type":"integer"},"reasoning_tokens":{"type":"integer"},"missing_fields":{"maxItems":0}}}},
        {"if":{"properties":{"quality":{"const":"Partial"}},"required":["quality"]},"then":{"properties":{"missing_fields":{"minItems":1,"maxItems":5}},"anyOf":[{"properties":{"input_tokens":{"type":"integer"}}},{"properties":{"output_tokens":{"type":"integer"}}},{"properties":{"total_tokens":{"type":"integer"}}},{"properties":{"cache_read_tokens":{"type":"integer"}}},{"properties":{"cache_write_tokens":{"type":"integer"}}},{"properties":{"reasoning_tokens":{"type":"integer"}}}]}},
        {"if":{"properties":{"quality":{"const":"Unknown"}},"required":["quality"]},"then":{"properties":{"input_tokens":{"type":"null"},"output_tokens":{"type":"null"},"total_tokens":{"type":"null"},"cache_read_tokens":{"type":"null"},"cache_write_tokens":{"type":"null"},"reasoning_tokens":{"type":"null"},"missing_fields":{"minItems":6,"maxItems":6}}}},
        {"if":{"properties":{"input_tokens":{"type":"null"}},"required":["input_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"input_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"input_tokens"}}}}}},
        {"if":{"properties":{"output_tokens":{"type":"null"}},"required":["output_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"output_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"output_tokens"}}}}}},
        {"if":{"properties":{"total_tokens":{"type":"null"}},"required":["total_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"total_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"total_tokens"}}}}}},
        {"if":{"properties":{"cache_read_tokens":{"type":"null"}},"required":["cache_read_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"cache_read_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"cache_read_tokens"}}}}}},
        {"if":{"properties":{"cache_write_tokens":{"type":"null"}},"required":["cache_write_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"cache_write_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"cache_write_tokens"}}}}}},
        {"if":{"properties":{"reasoning_tokens":{"type":"null"}},"required":["reasoning_tokens"]},"then":{"properties":{"missing_fields":{"contains":{"const":"reasoning_tokens"}}}},"else":{"properties":{"missing_fields":{"not":{"contains":{"const":"reasoning_tokens"}}}}}}
      ]
    },
    "Failure": {"type":"object","additionalProperties":false,"required":["code","cause_class","message"],"properties":{"code":{"enum":["DeadlineExceeded","BudgetExceeded","ModelUnavailable","ModelResponseInvalid","ToolFailure","UnsafeRetryBlocked","ExecutionStateUnknown","DiscussionAccessLost","CancelledByRequest","InternalError"]},"cause_class":{"enum":["TaskDeadline","Budget","Dependency","ModelProtocol","Tool","ExecutionUnknown","Authorization","Cancellation","Internal"]},"message":{"type":"string","minLength":1,"maxLength":8192}}},
    "AgentResult": {
      "type":"object","additionalProperties":false,
      "required":["run_id","task_id","generation","state","partial","summary","outputs","known_actions","usage","failure","published_at"],
      "properties":{"run_id":{"$ref":"#/$defs/Identifier"},"task_id":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"state":{"enum":["Completed","Failed","Cancelled"]},"partial":{"type":"boolean"},"summary":{"type":"string","maxLength":1048576},"outputs":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/OutputArtifact"}},"known_actions":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/KnownAction"}},"usage":{"$ref":"#/$defs/TokenUsage"},"failure":{"oneOf":[{"$ref":"#/$defs/Failure"},{"type":"null"}]},"published_at":{"$ref":"#/$defs/Timestamp"}},
      "allOf":[
        {"if":{"properties":{"state":{"const":"Completed"}},"required":["state"]},"then":{"properties":{"failure":{"type":"null"},"partial":{"const":false}}}},
        {"if":{"properties":{"state":{"const":"Failed"}},"required":["state"]},"then":{"properties":{"failure":{"$ref":"#/$defs/Failure"}}}},
        {"if":{"properties":{"state":{"const":"Cancelled"}},"required":["state"]},"then":{"properties":{"failure":{"allOf":[{"$ref":"#/$defs/Failure"},{"properties":{"code":{"const":"CancelledByRequest"},"cause_class":{"const":"Cancellation"}}}]}}}}
      ]
    },
    "RequestErrorCode": {"enum":["InvalidRequest","Unauthorized","ScopeDenied","NotFound","TaskConflict","RunNotTerminal","InvalidDiscussionContext","UnsupportedLimit","DeadlineExpired","QueueFull","DependencyUnavailable","ResultUnavailable","Gone"]},
    "ErrorEnvelope": {"type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"type":"object","additionalProperties":false,"required":["code","message","request_id"],"properties":{"code":{"$ref":"#/$defs/RequestErrorCode"},"message":{"type":"string","minLength":1,"maxLength":8192},"request_id":{"type":"string","minLength":1,"maxLength":128}}}}}
  }
}
